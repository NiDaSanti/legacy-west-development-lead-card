CLOSE_API_KEY=your_close_api_key_here

# Production only (set on Render):
# Restricts CORS on the API to your deployed Netlify frontend URL.
ALLOWED_ORIGIN=https://your-site.netlify.app

# Production only (set on Netlify, as a build-time env var):
# Points the frontend at your deployed Render API URL.
VITE_API_URL=https://your-api.onrender.com
